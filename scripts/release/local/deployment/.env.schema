# Provider deployment credentials; resolve locally and never retain values.
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my.1password.com, cacheTtl=false)
# ----------

# @sensitive @required
STAGE_NETLIFY_AUTH_TOKEN=op(op://dev/ephemeral-pages/STAGE_NETLIFY_AUTH_TOKEN)

# @sensitive @required
STAGE_CLOUDFLARE_API_TOKEN=op(op://dev/ephemeral-pages/STAGE_CLOUDFLARE_API_TOKEN)

# @sensitive @required
PRODUCTION_NETLIFY_AUTH_TOKEN=op(op://dev/ephemeral-pages/PRODUCTION_NETLIFY_AUTH_TOKEN)

# @sensitive @required
PRODUCTION_CLOUDFLARE_API_TOKEN=op(op://dev/ephemeral-pages/PRODUCTION_CLOUDFLARE_API_TOKEN)
