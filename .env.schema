# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
#
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my.1password.com)
# ----------

# Admin
# @sensitive @required
ADMIN_DELETE_TOKEN=op(op://dev/ephemeral-pages/admin-delete-token)

# Rate limiting
# @sensitive @required
RATE_LIMIT_SECRET=op(op://dev/ephemeral-pages/rate-limit-secret)

# GitHub Actions OIDC
GITHUB_OIDC_AUDIENCE=https://ephemeral.schalkneethling.com

# Public page URLs
PUBLIC_BASE_URL=https://ephemeral.schalkneethling.com

# Collaboration
COLLABORATION_CAPABILITY_CURRENT_VERSION=v1

# @sensitive @required
COLLABORATION_CAPABILITY_CURRENT_SECRET=op(op://dev/ephemeral-pages/collaboration-capability-current-secret)

# Set all three previous-key values only during a bounded rotation window.
# COLLABORATION_CAPABILITY_PREVIOUS_VERSION=v0
# COLLABORATION_CAPABILITY_PREVIOUS_SECRET=op(op://dev/ephemeral-pages/collaboration-capability-previous-secret)
# COLLABORATION_CAPABILITY_PREVIOUS_VALID_UNTIL=2026-08-30T00:00:00.000Z

# @sensitive @required
COLLABORATION_TICKET_SECRET=op(op://dev/ephemeral-pages/collaboration-ticket-secret)

COLLABORATION_TICKET_AUDIENCE=ephemeral-pages-collaboration
COLLABORATION_WEBSOCKET_URL=wss://collaboration.ephemeral.schalkneethling.com
COLLABORATION_SERVICE_URL=https://collaboration.ephemeral.schalkneethling.com

# @sensitive @required
COLLABORATION_SERVICE_TOKEN=op(op://dev/ephemeral-pages/collaboration-service-token)

# Error logging
# @sensitive
SENTRY_DSN=op(op://dev/ephemeral-pages/sentry-dsn)

SENTRY_ENVIRONMENT=development
